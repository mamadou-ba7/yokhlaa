{
  "name": "yokhlaa",
  "version": "1.0.0",
  "description": "Yokh Laa - Transport Dakar sans commission",
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "APP_ROLE=passenger expo start",
    "start:passenger": "APP_ROLE=passenger expo start",
    "start:driver": "APP_ROLE=driver expo start",
    "web": "APP_ROLE=passenger expo start --web",
    "web:passenger": "APP_ROLE=passenger expo start --web",
    "web:driver": "APP_ROLE=driver expo start --web",
    "ios": "APP_ROLE=passenger expo run:ios",
    "ios:passenger": "APP_ROLE=passenger expo run:ios",
    "ios:driver": "APP_ROLE=driver expo run:ios",
    "android": "APP_ROLE=passenger expo run:android",
    "android:passenger": "APP_ROLE=passenger expo run:android",
    "android:driver": "APP_ROLE=driver expo run:android",
    "export:passenger": "APP_ROLE=passenger expo export --platform web",
    "export:driver": "APP_ROLE=driver expo export --platform web"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@expo/metro-runtime": "^55.0.6",
    "@expo/vector-icons": "^15.1.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/bottom-tabs": "^7.15.5",
    "@react-navigation/native": "^7.1.33",
    "@react-navigation/native-stack": "^7.14.4",
    "@supabase/supabase-js": "^2.99.0",
    "@types/react": "~19.2.10",
    "expo": "~55.0.13",
    "expo-build-properties": "^55.0.13",
    "expo-constants": "~55.0.7",
    "expo-device": "~55.0.14",
    "expo-font": "^55.0.4",
    "expo-haptics": "~55.0.14",
    "expo-image-picker": "~55.0.18",
    "expo-linear-gradient": "~55.0.13",
    "expo-location": "~55.1.8",
    "expo-notifications": "~55.0.18",
    "expo-secure-store": "~55.0.13",
    "expo-status-bar": "~55.0.5",
    "expo-task-manager": "~55.0.14",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-native": "0.83.4",
    "react-native-maps": "1.27.2",
